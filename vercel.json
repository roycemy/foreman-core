{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "fm_sess"
        }
      ],
      "destination": "/hq",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    },
    {
      "source": "/runner",
      "destination": "/runner.html"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/oauth.html"
    },
    {
      "source": "/hq",
      "destination": "/app.html"
    },
    {
      "source": "/receipt/:token",
      "destination": "/api/index"
    },
    {
      "source": "/og/:file",
      "destination": "/api/og"
    },
    {
      "source": "/api/og/:file",
      "destination": "/api/og"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/hq",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/receipt/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "api/fonts/**"
    }
  }
}
